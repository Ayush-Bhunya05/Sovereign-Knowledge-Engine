# Sovereign Knowledge Engine — Environment Variables Example
# Duplicate this file as .env and replace placeholders with your credentials

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/docrag

# Vector Database (ChromaDB - Embedded, zero Docker required)
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=chroma_db

# Storage
UPLOAD_DIR=uploads

# AI & LLM (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here
