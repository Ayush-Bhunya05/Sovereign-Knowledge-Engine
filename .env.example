# =============================================================================
# AI Document RAG — Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed.
# =============================================================================

# Application
APP_NAME=AI Document RAG
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL
DATABASE_URL="postgresql://docrag:docrag@localhost:5433/docrag"

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173
